# Copy to `.env` and fill in. `docker compose` reads it automatically.

# --- public identity -------------------------------------------------------
# Your DDNS hostname. Used by Caddy for the certificate, and told to clients as
# the address of their match server — never an IP, because Telekom reconnects
# you onto a new one roughly daily.
# Both must be the same value. They are written out twice on purpose: compose
# interpolates the compose file from this file, but passes `env_file` lines to
# the container verbatim, so a ${...} reference here would reach the backend
# as the literal characters.
PUBLIC_HOSTNAME=yabranked.example.duckdns.org
YABRANKED_PUBLIC_HOST=yabranked.example.duckdns.org

# --- database --------------------------------------------------------------
# Without this every player, rating, match and replay index is lost on restart.
#
# Reached by container name on the shared `yabranked-net`, so Postgres publishes
# no ports at all and is unreachable from the LAN. A hosted database (Neon's free
# tier needs no card) works too — use its URL and keep `sslmode=require`.
YABRANKED_DATABASE_URL=postgresql://yabranked:CHANGEME@yabranked-postgres:5432/yabranked

# --- matches ---------------------------------------------------------------
# Host port for the backend. 8080 is a busy number; change it if something else
# already listens there, and keep the agent URL below in step.
BACKEND_HOST_PORT=8080
YABRANKED_BACKEND_URL_FOR_AGENTS=http://host.docker.internal:8080

YABRANKED_ORCHESTRATE=1

# Off, so a match container gets a bridge network and one published port rather
# than your host's network stack. With host networking a compromised Minecraft
# server is on your LAN.
YABRANKED_HOST_NETWORK=false

# A Pi 5 will not run three 4 GB servers. Two cores each leaves the backend room.
YABRANKED_MATCH_MEMORY=2g
YABRANKED_MATCH_CPUS=2

# --- replays ---------------------------------------------------------------
# Object storage wins over a directory when both are set. By container name
# again, so this works without publishing MinIO to the network.
YABRANKED_REPLAY_S3_ENDPOINT=http://minio:9000
YABRANKED_REPLAY_S3_BUCKET=yabranked-replays
YABRANKED_REPLAY_S3_ACCESS_KEY=yabranked
YABRANKED_REPLAY_S3_SECRET_KEY=CHANGEME
# Region is meaningless to MinIO and R2 but the SDK insists on one.
YABRANKED_REPLAY_S3_REGION=auto

# Fallback if you would rather use a plain directory: unset the S3 block above.
# YABRANKED_REPLAY_DIR=/data/replays
# Host path bound to the above. Never the SD card — a match writes tens of MB.
REPLAY_HOST_DIR=/mnt/storage/yabranked/replays

# --- publishing ------------------------------------------------------------
# Old jars get a clean 426 instead of confusing failures. Set to the oldest
# client version you still support.
# YABRANKED_MIN_CLIENT_VERSION=0.1.0

# Admin endpoints (/v1/admin/*). Leave unset to disable them entirely.
# YABRANKED_ADMIN_TOKEN=
