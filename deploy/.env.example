# Copy to `.env` and fill in. `docker compose` reads it automatically.
#
# Uncomment a setting where it stands rather than appending a second copy at the
# bottom. Both compose and systemd's `EnvironmentFile` apply lines in order and
# let the **last** assignment of a key win, silently — a stale line further down
# overrides the value you just edited, and nothing warns you. Checking that a
# key appears once is the fastest way to explain a setting that "isn't taking":
#
#     grep -c YABRANKED_PORT_MAP .env

# --- public identity -------------------------------------------------------
# Your DDNS hostname. Used by Caddy for the certificate, and told to clients as
# the address of their match server — never an IP, because Telekom reconnects
# you onto a new one roughly daily.
# Both must be the same value. They are written out twice on purpose: compose
# interpolates the compose file from this file, but passes `env_file` lines to
# the container verbatim, so a ${...} reference here would reach the backend
# as the literal characters.
PUBLIC_HOSTNAME=yabranked.example.duckdns.org
YABRANKED_PUBLIC_HOST=yabranked.example.duckdns.org

# --- database --------------------------------------------------------------
# Without this every player, rating, match and replay index is lost on restart.
#
# A **JDBC** URL, and credentials go separately — `postgresql://user:pass@host/db`
# is the psql form and fails with "No suitable driver", which reads like a
# missing dependency rather than a malformed URL.
#
# Reached by container name on the shared `yabranked-net` when the backend runs
# in compose; use 127.0.0.1 if it runs natively on the host. A hosted database
# (Neon's free tier needs no card) works too — append `?sslmode=require`.
YABRANKED_DATABASE_URL=jdbc:postgresql://yabranked-postgres:5432/yabranked
YABRANKED_DATABASE_USER=yabranked
YABRANKED_DATABASE_PASSWORD=CHANGEME

# --- matches ---------------------------------------------------------------
# Host port for the backend. 8080 is a busy number; change it if something else
# already listens there, and keep the agent URL below in step.
BACKEND_HOST_PORT=8080
YABRANKED_BACKEND_URL_FOR_AGENTS=http://host.docker.internal:8080

YABRANKED_ORCHESTRATE=1

# Off, so a match container gets a bridge network and one published port rather
# than your host's network stack. With host networking a compromised Minecraft
# server is on your LAN.
YABRANKED_HOST_NETWORK=false

# A Pi 5 will not run three 4 GB servers, so the memory is halved from the
# default. The cores are not: at two, YAB's asynchronous spawn search runs into
# its own 60-second timeout and falls back to a worse position, and the minute
# it burns doing so is a minute of players sitting in a lobby watching nothing
# happen. Four is the default for the same reason it is the default.
YABRANKED_MATCH_MEMORY=2g
YABRANKED_MATCH_CPUS=4

# Match ports behind a tunnel, for hosts that cannot port forward.
#
# A tunnel gives out a public address of its choosing and forwards it to a local
# port you pick, so `PUBLIC_HOST:localPort` would send players to a port nobody
# is listening on. Each entry is `localPort=address`; the address may carry a
# port (`host:45123`, a plain TCP tunnel) or not (`host`, a playit.gg
# "Minecraft Java" tunnel, where an SRV record supplies it).
#
# Setting this also *replaces* the port range: only mapped ports are allocated,
# so the number of entries is the real cap on concurrent matches — which is the
# honest number for a tunnelled host anyway.
#
# Substitute your own tunnel names. The placeholders below are deliberately not
# valid hostnames, because a plausible-looking one is worse than a broken one:
# every `*.tun.ply.gg` and `*.gl.joinmc.link` name resolves to the same playit
# edge IP and an SRV port, so a copied example can *connect* — to whichever
# account happens to hold that port. Players land in a stranger's server, and
# nothing in the logs says the address was never yours.
#
# YABRANKED_PORT_MAP=25600=REPLACE-ME-1.tun.ply.gg,25601=REPLACE-ME-2.tun.ply.gg

# --- replays ---------------------------------------------------------------
# Object storage wins over a directory when both are set. By container name
# again, so this works without publishing MinIO to the network.
YABRANKED_REPLAY_S3_ENDPOINT=http://minio:9000
YABRANKED_REPLAY_S3_BUCKET=yabranked-replays
YABRANKED_REPLAY_S3_ACCESS_KEY=yabranked
YABRANKED_REPLAY_S3_SECRET_KEY=CHANGEME
# Region is meaningless to MinIO and R2 but the SDK insists on one.
YABRANKED_REPLAY_S3_REGION=auto

# Fallback if you would rather use a plain directory: unset the S3 block above.
# YABRANKED_REPLAY_DIR=/data/replays
# Host path bound to the above. Never the SD card — a match writes tens of MB.
REPLAY_HOST_DIR=/mnt/storage/yabranked/replays

# How much of that disk replays may take. The defaults assume a host with room:
# 7 days, 10 pinned recordings and 2 GiB pinned per player, 512 MiB per match.
# On a small disk turn all four down — the arithmetic that matters is
# (matches per day) x (players per match) x (size per recording) x (days).
# Sizes take a k/m/g suffix or plain bytes.
# YABRANKED_REPLAY_RETENTION_DAYS=3
# YABRANKED_REPLAY_SAVED_PER_PLAYER=5
# YABRANKED_REPLAY_SAVED_BYTES_PER_PLAYER=512m
# YABRANKED_REPLAY_MAX_RECORDING_BYTES=256m

# --- match server logs -----------------------------------------------------
# A match container's log is deleted with the container, and it is the only
# record of what happened *inside* a match: whether the agent configured YAB,
# whether the game ever ended, why a result never arrived. Set this and the
# backend copies each one out before the teardown, named <matchId>.log. The
# newest 50 are kept.
# YABRANKED_MATCH_LOG_DIR=/var/lib/yabranked/match-logs

# --- publishing ------------------------------------------------------------
# Old jars get a clean 426 instead of confusing failures. Set to the oldest
# client version you still support.
# YABRANKED_MIN_CLIENT_VERSION=0.1.0

# Admin endpoints (/v1/admin/*). Leave unset to disable them entirely.
# YABRANKED_ADMIN_TOKEN=
