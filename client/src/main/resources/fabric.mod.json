{
  "schemaVersion": 1,
  "id": "yabranked-client",
  "version": "${version}",
  "name": "YAB Ranked",
  "description": "Competitive ranked queue for Yet Another Bingo: skill-based 1v1 lockout matchmaking, ratings, and leaderboards.",
  "icon": "assets/yabranked-client/icon.png",
  "authors": [
    "Ovilli"
  ],
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.yabranked.client.YabRankedClient"
      }
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "dev.yabranked.client.compat.ModMenuIntegration"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": ">=26.2",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  }
}
