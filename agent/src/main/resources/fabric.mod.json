{
  "schemaVersion": 1,
  "id": "yabranked-agent",
  "version": "${version}",
  "name": "YAB Ranked Agent",
  "description": "Match-server orchestration agent for YAB Ranked. Configures and monitors a single ranked bingo match, then reports the result to the ranked backend.",
  "authors": ["Ovilli"],
  "license": "LGPL-3.0-only",
  "environment": "server",
  "entrypoints": {
    "server": [
      {
        "adapter": "kotlin",
        "value": "dev.yabranked.agent.YabRankedAgent"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": ">=26.2",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "yet-another-minecraft-bingo": ">=2.12.1"
  }
}
